{
  "name": "frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "schema:check": "node scripts/check-schema.mjs",
    "codegen": "npm run schema:check && graphql-codegen --config codegen.yml",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/api/generated.ts"
  },
  "dependencies": {
    "@apollo/client": "3.13.9",
    "apollo-upload-client": "18.0.1",
    "graphql": "16.11.0",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.15.0",
    "globals": "17.6.0",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  }
}
